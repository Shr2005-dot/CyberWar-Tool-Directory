---
/**
 * Tools-browser sidebar.
 *
 * Responsive behaviour from README → "📱 Responsive Architecture":
 *   - desktop (lg+): sticky sidebar next to the content
 *   - tablet      : collapsed behind a toggle
 *   - mobile      : single column, categories become collapsible sections
 *
 * It is rendered by BaseLayout when a page opts in with `sidebar`; the
 * homepage does not (README → "🏠 Homepage Architecture").
 */
import { categories } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string): boolean => path === href || path.startsWith(`${href}/`);
---

<div class="lg:hidden">
  <button
    id="side-open"
    type="button"
    class="flex w-full items-center justify-between rounded-xl border border-border bg-card px-4 py-3 text-sm font-medium text-muted transition hover:text-foreground"
    aria-controls="side-nav"
    aria-expanded="false"
  >
    <span>Browse categories</span>
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="h-4 w-4"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>
</div>

<aside
  id="side-nav"
  class="hidden w-full shrink-0 lg:block lg:w-64"
  aria-label="Tool categories"
>
  <div class="lg:sticky lg:top-20 lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto lg:pb-10 lg:pr-1">
    <p class="mb-2 px-3 text-xs font-semibold uppercase tracking-wider text-subtle">
      Tools
    </p>
    <nav class="flex flex-col gap-0.5">
      {
        categories.map((category) => {
          const categoryHref = `/tools/${category.slug}`;
          return (
            <details class="disclosure" open>
              <summary
                class:list={[
                  'flex items-center gap-3 rounded-lg px-2.5 py-2 text-sm transition',
                  isActive(categoryHref)
                    ? 'text-accent'
                    : 'text-muted hover:bg-elevated hover:text-foreground',
                ]}
              >
                <span
                  class="cat-accent cat-accent-bg inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-xs"
                  style={`--cat-accent:${category.accent}`}
                  aria-hidden="true"
                >
                  {category.glyph}
                </span>
                <span class="flex-1 font-medium">{category.name}</span>
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="disclosure-icon h-4 w-4 text-subtle"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <div class="border-l border-border pb-1 pl-4 ml-3.5">
                {category.subcategories.map((sub) => (
                  <a
                    href={`/tools/${category.slug}/${sub.slug}`}
                    class="block rounded-md px-2 py-1.5 text-sm text-muted transition hover:bg-elevated hover:text-foreground"
                  >
                    {sub.name}
                  </a>
                ))}
              </div>
            </details>
          );
        })
      }
    </nav>
  </div>
</aside>

<script>
  // Collapses the sidebar on tablet/mobile where it is hidden by default.
  const sideOpenButton = document.getElementById('side-open');
  const sidePanel = document.getElementById('side-nav');

  sideOpenButton?.addEventListener('click', () => {
    if (!sidePanel || !sideOpenButton) return;
    const isHidden = sidePanel.classList.toggle('hidden');
    sideOpenButton.setAttribute('aria-expanded', String(!isHidden));
  });
</script>